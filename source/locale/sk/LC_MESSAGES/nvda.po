#: soundWave_lib/main.py:2075 soundWave_lib/main.py:2239
msgid ""
"Orpheus offline capture requires Orpheus to be your current NVDA synthesizer.\n"
"\n"
"Please switch NVDA to Orpheus, then open soundWave again."
msgstr ""
"Offline zachytávanie Orpheus vyžaduje, aby bol Orpheus aktuálnym syntezátorom NVDA.\n"
"\n"
"Prepnite NVDA na Orpheus a potom znova otvorte soundWave."

#: soundWave_lib/main.py:2140
#, python-brace-format
msgid "{synth} could not open its options dialog."
msgstr "{synth} nemohol otvoriť dialóg možností."

