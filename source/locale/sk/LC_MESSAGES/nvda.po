msgstr "Tento syntezátor"

#: soundWave_lib/main.py:2215
msgid "Rendering started."
msgstr "Vykresľovanie spustené."

#: soundWave_lib/main.py:2279
#, python-brace-format
msgid ""
"Orpheus rendering requires switching NVDA temporarily to a fallback synthesizer, but switching to"
" '{fallback_synth}' failed.\n"
"\n"
"Please ensure at least one non-Orpheus NVDA synthesizer is available, then try again."
msgstr ""
"Vykresľovanie Orpheus vyžaduje dočasné prepnutie NVDA na záložný syntezátor, ale prepnutie na "
"'{fallback_synth}' zlyhalo.\n"
"\n"
"Uistite sa, že je dostupný aspoň jeden syntezátor NVDA iný než Orpheus, a potom to skúste znova."

#: soundWave_lib/main.py:2310
msgid "Google TTS For NVDA could not be initialized for rendering."
msgstr "Google TTS For NVDA sa nepodarilo inicializovať na vykresľovanie."

#: soundWave_lib/main.py:2350
msgid "Orpheus capture couldn't access the live Orpheus instance."
msgstr "Zachytávanie Orpheus nemohlo získať prístup k aktívnej inštancii Orpheus."

#: soundWave_lib/main.py:2358
msgid ""
"SoundWave could not find the installed Eloquence/IBMTTS speech engine.\n"
"\n"
"Install or update the Eloquence or IBMTTS NVDA add-on, reload NVDA, then try again."
msgstr ""
"SoundWave nemohol nájsť nainštalovaný rečový engine Eloquence/IBMTTS.\n"
"\n"
"Nainštalujte alebo aktualizujte doplnok Eloquence alebo IBMTTS pre NVDA, znovu načítajte NVDA a "
"skúste to znova."

