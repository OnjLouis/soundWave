#: source/soundWave_lib/main.py:2341
#, python-brace-format
msgid ""
"Orpheus rendering requires switching NVDA temporarily to a fallback synthesizer, but switching to"
" '{fallback_synth}' failed.\n"
"\n"
"Please ensure at least one non-Orpheus NVDA synthesizer is available, then try again."
msgstr ""
"Renderowanie Orpheus wymaga tymczasowego przełączenia NVDA na syntezator zapasowy, ale "
"przełączenie na '{fallback_synth}' nie powiodło się.\n"
"\n"
"Upewnij się, że dostępny jest co najmniej jeden syntezator NVDA inny niż Orpheus, a potem spróbuj"
" ponownie."

#: source/soundWave_lib/main.py:2372
msgid "Google TTS For NVDA could not be initialized for rendering."
msgstr "Nie można zainicjować Google TTS For NVDA do renderowania."

#: source/soundWave_lib/main.py:2413
msgid "Orpheus capture couldn't access the live Orpheus instance."
msgstr "Przechwytywanie Orpheus nie mogło uzyskać dostępu do aktywnej instancji Orpheus."

#: source/soundWave_lib/main.py:2421
msgid ""
"SoundWave could not find the installed Eloquence/IBMTTS speech engine.\n"
"\n"
"Install or update the Eloquence or IBMTTS NVDA add-on, reload NVDA, then try again."
msgstr ""
"SoundWave nie mógł znaleźć zainstalowanego silnika mowy Eloquence/IBMTTS.\n"
"\n"
"Zainstaluj lub zaktualizuj dodatek Eloquence albo IBMTTS dla NVDA, uruchom ponownie NVDA i "
"spróbuj jeszcze raz."

