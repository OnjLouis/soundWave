#: source/soundWave_lib/main.py:2146 source/soundWave_lib/main.py:2310
msgid ""
"Orpheus offline capture requires Orpheus to be your current NVDA "
"synthesizer.\n"
"\n"
"Please switch NVDA to Orpheus, then open soundWave again."
msgstr ""
"Przechwytywanie offline Orpheus wymaga, aby Orpheus był bieżącym "
"syntezatorem NVDA.\n"
"\n"
"Przełącz NVDA na Orpheus, a potem ponownie otwórz soundWave."

#: source/soundWave_lib/main.py:2211
#, python-brace-format
msgid "{synth} could not open its options dialog."
msgstr "{synth} nie mógł otworzyć okna opcji."

#: source/soundWave_lib/main.py:2212
msgid "This synth"
msgstr "Ten syntezator"

#: source/soundWave_lib/main.py:2286
msgid "Rendering started."
msgstr "Rozpoczęto renderowanie."

#: source/soundWave_lib/main.py:2350
#, python-brace-format
msgid ""
"Orpheus rendering requires switching NVDA temporarily to a fallback "
"synthesizer, but switching to '{fallback_synth}' failed.\n"
"\n"
"Please ensure at least one non-Orpheus NVDA synthesizer is available, "
"then try again."
msgstr ""
"Renderowanie Orpheus wymaga tymczasowego przełączenia NVDA na syntezator "
"zapasowy, ale przełączenie na '{fallback_synth}' nie powiodło się.\n"
"\n"
"Upewnij się, że dostępny jest co najmniej jeden syntezator NVDA inny niż "
"Orpheus, a potem spróbuj ponownie."

#: source/soundWave_lib/main.py:2381
msgid "Google TTS For NVDA could not be initialized for rendering."
msgstr "Nie można zainicjować Google TTS For NVDA do renderowania."

#: source/soundWave_lib/main.py:2422
msgid "Orpheus capture couldn't access the live Orpheus instance."
msgstr ""
"Przechwytywanie Orpheus nie mogło uzyskać dostępu do aktywnej instancji "
"Orpheus."

#: source/soundWave_lib/main.py:2430
msgid ""
"SoundWave could not find the installed Eloquence/IBMTTS speech engine.\n"
"\n"
"Install or update the Eloquence or IBMTTS NVDA add-on, reload NVDA, then "
"try again."
msgstr ""
"SoundWave nie mógł znaleźć zainstalowanego silnika mowy Eloquence/IBMTTS."
"\n"
"\n"
"Zainstaluj lub zaktualizuj dodatek Eloquence albo IBMTTS dla NVDA, "
"uruchom ponownie NVDA i spróbuj jeszcze raz."

